generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @db.Uuid
  email              String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  profile            Profile?
  resumeDocuments    ResumeDocument[]
  resumeReviews      ResumeReview[]
  jobDescriptions    JobDescription[]
  jobMatchAnalyses   JobMatchAnalysis[]
  preparationPlans   PreparationPlan[]
  applicationDrafts  ApplicationDraft[]
  assessmentAttempts AssessmentAttempt[]
  interviewSessions   InterviewSession[]
  performanceReports  PerformanceReport[]
  consents            UserConsent[]
  dataRequests        DataRequest[]
  analyticsEvents     AnalyticsEvent[]
  // JOB-85 ontology
  skills              Skill[]
  careerEvidence      CareerEvidence[]
  achievements        Achievement[]
  starStories         StarStory[]
  senioritySignals    SenioritySignal[]
  targetRoles         TargetRole[]
  evidenceSkillLinks  EvidenceSkillLink[]
  requirementMatches  RequirementEvidenceMatch[]
  readinessScores     ApplicationReadinessScore[]
  applicationOutcomes ApplicationOutcome[]
  aiUsageEvents       AiUsageEvent[]
  subscriptions       Subscription[]
  entitlementGrants   EntitlementGrant[]
  billingEvents       BillingEvent[]
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  props     Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([name])
  @@index([createdAt])
  @@index([userId, name])
}

model UserConsent {
  id         String   @id @default(cuid())
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // upload | ai_processing
  kind       String
  // copy version string e.g. "2026-07-17"
  version    String
  acceptedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, kind, version])
  @@index([userId])
}

model DataRequest {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // export | deletion
  type      String
  // pending | completed | rejected
  status    String   @default("pending")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ResumeDocument {
  id               String   @id @default(cuid())
  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalFilename String
  mimeType         String
  byteSize         Int
  storageProvider  String   @default("supabase")
  storagePath      String
  status           String
  rawText          String?  @db.Text
  parseError       String?
  parsedData       Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  resumeReviews     ResumeReview[]
  jobMatchAnalyses  JobMatchAnalysis[]
  applicationDrafts ApplicationDraft[]

  @@index([userId])
}

model ResumeReview {
  id               String         @id @default(cuid())
  userId           String         @db.Uuid
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeDocumentId String
  resumeDocument   ResumeDocument @relation(fields: [resumeDocumentId], references: [id], onDelete: Cascade)
  status           String
  model            String?
  errorMessage     String?
  result           Json?
  overallScore     Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
  @@index([resumeDocumentId])
}

model Profile {
  id                    String    @id @default(cuid())
  userId                String    @unique @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  educationBackground   String
  experienceLevel       String
  targetRole            String
  targetIndustry        String
  preferredLocation     String
  jobSearchStatus       String
  careerSwitchIntent    Boolean   @default(false)
  skills                String[]  @default([])
  certifications        String[]  @default([])
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model JobDescription {
  id            String             @id @default(cuid())
  userId        String             @db.Uuid
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String?
  company       String?
  sourceNote    String?
  rawText       String             @db.Text
  extracted     Json?
  status        String
  errorMessage  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  matchAnalyses     JobMatchAnalysis[]
  applicationDrafts ApplicationDraft[]
  requirementMatches RequirementEvidenceMatch[]

  @@index([userId])
}

model JobMatchAnalysis {
  id               String          @id @default(cuid())
  userId           String          @db.Uuid
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobDescriptionId String
  jobDescription   JobDescription  @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  resumeDocumentId String?
  resumeDocument   ResumeDocument? @relation(fields: [resumeDocumentId], references: [id], onDelete: SetNull)
  status           String
  model            String?
  errorMessage     String?
  result           Json?
  matchScore       Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
  @@index([jobDescriptionId])
}

model PreparationPlan {
  id                     String                @id @default(cuid())
  userId                 String                @db.Uuid
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                  String                @default("My prep plan")
  status                 String
  sourceProfileUpdatedAt DateTime?
  sourceResumeReviewId   String?
  sourceJobMatchId       String?
  model                  String?
  summary                String?               @db.Text
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  items                  PreparationPlanItem[]

  @@index([userId])
}

model PreparationPlanItem {
  id          String          @id @default(cuid())
  planId      String
  plan        PreparationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  category    String
  title       String
  description String?         @db.Text
  reason      String?         @db.Text
  priority    Int             @default(0)
  status      String          @default("todo")
  href        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([planId])
}

model ApplicationDraft {
  id               String           @id @default(cuid())
  userId           String           @db.Uuid
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // cover_letter | recruiter_dm | referral_request | application_note
  type             String
  title            String
  // draft | generating | failed
  status           String           @default("draft")
  // professional | enthusiastic | formal | concise
  tone             String?
  // short | medium | long (cover letter primarily)
  length           String?
  content          String           @db.Text
  // { intro?: string, body?: string, closing?: string }
  sections         Json?
  // generation options / provenance snapshot
  meta             Json?
  jobDescriptionId String?
  jobDescription   JobDescription?  @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  resumeDocumentId String?
  resumeDocument   ResumeDocument?  @relation(fields: [resumeDocumentId], references: [id], onDelete: SetNull)
  // Version lineage: null = root; prior draft id when superseding
  supersedesId     String?
  version          Int              @default(1)
  model            String?
  errorMessage     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId])
  @@index([userId, type])
  @@index([jobDescriptionId])
  @@index([resumeDocumentId])
}

// Global practice content (not user-owned). Status/disclaimer fields are strings.
model AssessmentCategory {
  id             String               @id @default(cuid())
  slug           String               @unique
  name           String
  description    String?              @db.Text
  sortOrder      Int                  @default(0)
  // e.g. practice_only — UI disclaimer framing (not clinical / not employment screening)
  disclaimerKind String               @default("practice_only")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  questions      AssessmentQuestion[]
  attempts       AssessmentAttempt[]
}

model AssessmentQuestion {
  id            String              @id @default(cuid())
  categoryId    String
  category      AssessmentCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  prompt        String              @db.Text
  // [{ key, label }] for MCQ; null/empty for free-text reflection
  choices       Json?
  // Null for reflection items (no single correct answer)
  correctAnswer String?
  explanation   String?             @db.Text
  // easy | medium | hard (optional)
  difficulty    String?
  sortOrder     Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  answers       AssessmentAnswer[]

  @@index([categoryId])
}

// User-owned practice run against a global category
model AssessmentAttempt {
  id          String             @id @default(cuid())
  userId      String             @db.Uuid
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    AssessmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // in_progress | completed
  status      String
  score       Int?
  maxScore    Int?
  summary     Json?
  startedAt   DateTime           @default(now())
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  answers     AssessmentAnswer[]

  @@index([userId])
  @@index([categoryId])
  @@index([userId, categoryId])
}

model AssessmentAnswer {
  id          String             @id @default(cuid())
  attemptId   String
  attempt     AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId  String
  question    AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedKey String?
  freeText    String?            @db.Text
  // Null for reflection items
  isCorrect   Boolean?
  createdAt   DateTime           @default(now())

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model InterviewSession {
  id                    String          @id @default(cuid())
  userId                String          @db.Uuid
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // active | completed | abandoned
  status                String
  targetRole            String
  experienceLevel       String?
  targetIndustry        String?
  resumeDocumentId      String?
  jobDescriptionId      String?
  preparationPlanItemId String?
  title                 String?
  model                 String?
  errorMessage          String?
  startedAt             DateTime        @default(now())
  completedAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  turns                 InterviewTurn[]

  @@index([userId])
  @@index([userId, status])
}

model InterviewTurn {
  id            String           @id @default(cuid())
  sessionId     String
  session       InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // primary | follow_up
  kind          String
  // behavioral | motivation | competency | role_specific | follow_up
  category      String?
  orderIndex    Int
  question      String           @db.Text
  answer        String?          @db.Text
  answeredAt    DateTime?
  parentTurnId  String?
  // InterviewFeedback JSON (JOB-12)
  feedback      Json?
  feedbackModel String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([sessionId])
  @@index([sessionId, orderIndex])
}

// Compiled readiness report (JOB-15). Status is a string: generating | ready | failed.
// Coaching guidance only — never hire/no-hire predictions.
model PerformanceReport {
  id                   String   @id @default(cuid())
  userId               String   @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // generating | ready | failed
  status               String
  version              Int      @default(1)
  title                String
  summary              String?  @db.Text
  // PerformanceReportSections JSON (zod: performanceReportSectionsSchema)
  sections             Json?
  // optional provenance (assessment attempt ids, narrative source, etc.)
  meta                 Json?
  resumeReviewId       String?
  jobMatchAnalysisId   String?
  interviewSessionId   String?
  preparationPlanId    String?
  model                String?
  errorMessage         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}

// Global curated interview video library (not user-owned). Human-made / external hosts only.
model InterviewVideo {
  id                String   @id @default(cuid())
  title             String
  url               String
  // e.g. behavioral, technical, case, motivation
  categoryTags      String[] @default([])
  // Empty arrays mean "all" for that filter dimension
  targetRoles       String[] @default([])
  targetIndustries  String[] @default([])
  experienceLevels  String[] @default([])
  summary           String?  @db.Text
  transcript        String?  @db.Text
  published         Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([published])
}

// ---------------------------------------------------------------------------
// JOB-85 — Shared career evidence ontology
// verification: imported | inferred | unconfirmed | confirmed | archived
// ---------------------------------------------------------------------------

model Skill {
  id             String             @id @default(cuid())
  userId         String             @db.Uuid
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  // lowercased trimmed key for dedupe
  normalizedName String
  // technical | soft | domain | tool | language | other
  category       String?
  verification   String             @default("unconfirmed")
  confidence     Float              @default(0.5)
  // profile | resume | user | match | other
  sourceType     String?
  sourceId       String?
  version        Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  evidenceLinks  EvidenceSkillLink[]

  // Uniqueness for active skills is enforced in app (mergeDuplicateSkills /
  // planSkillsFromProfile). DB unique would block re-create after soft-archive.
  @@index([userId, normalizedName])
  @@index([userId])
  @@index([userId, verification])
}

model CareerEvidence {
  id               String             @id @default(cuid())
  userId           String             @db.Uuid
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  // employment | education | volunteering | freelance | project | competition | other
  sourceType       String
  organization     String?
  roleTitle        String?
  startDate        String?
  endDate          String?
  responsibilities String?            @db.Text
  achievements     String?            @db.Text
  metrics          String?            @db.Text
  verification     String             @default("unconfirmed")
  confidence       Float              @default(0.5)
  provenance       Json?
  sourceNote       String?
  version          Int                @default(1)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  achievementItems Achievement[]
  starStories      StarStory[]
  skillLinks       EvidenceSkillLink[]

  @@index([userId])
  @@index([userId, verification])
}

model Achievement {
  id           String         @id @default(cuid())
  evidenceId   String
  evidence     CareerEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  userId       String         @db.Uuid
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  statement    String         @db.Text
  metricLabel  String?
  metricValue  String?
  verification String         @default("unconfirmed")
  confidence   Float          @default(0.5)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([evidenceId])
  @@index([userId])
}

model StarStory {
  id           String          @id @default(cuid())
  userId       String          @db.Uuid
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidenceId   String?
  evidence     CareerEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  title        String
  situation    String          @db.Text
  task         String          @db.Text
  action       String          @db.Text
  result       String          @db.Text
  // draft | ready | archived
  readiness    String          @default("draft")
  verification String          @default("unconfirmed")
  confidence   Float           @default(0.5)
  version      Int             @default(1)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
  @@index([userId, readiness])
  @@index([evidenceId])
}

model SenioritySignal {
  id           String   @id @default(cuid())
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // years_experience | level_label | scope | team_size | other
  kind         String
  value        String
  verification String   @default("unconfirmed")
  confidence   Float    @default(0.5)
  sourceType   String?
  sourceId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([userId, kind])
}

model TargetRole {
  id         String   @id @default(cuid())
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  industry   String?
  priority   Int      @default(0)
  // profile | user
  sourceType String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([userId, isPrimary])
}

model EvidenceSkillLink {
  evidenceId String
  skillId    String
  userId     String         @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence   CareerEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  skill      Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  // primary | secondary | mentioned
  strength   String         @default("mentioned")
  createdAt  DateTime       @default(now())

  @@id([evidenceId, skillId])
  @@index([userId])
  @@index([skillId])
}


// JOB-86 — requirement to evidence mapping
model RequirementEvidenceMatch {
  id               String          @id @default(cuid())
  userId           String          @db.Uuid
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobDescriptionId String
  jobDescription   JobDescription  @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  requirementKey   String
  requirementText  String
  // required | preferred | other
  importance       String
  // strong | partial | keyword_only | transferable | gap
  matchType        String
  evidenceStrength Int             @default(0)
  confidence       Float           @default(0.5)
  explanation      String          @db.Text
  evidenceId       String?
  skillId          String?
  starStoryId      String?
  // suggested | confirmed | rejected | replaced
  userReview       String          @default("suggested")
  safeAction       String?         @db.Text
  version          Int             @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([userId, jobDescriptionId, requirementKey])
  @@index([userId])
  @@index([jobDescriptionId])
  @@index([userId, jobDescriptionId])
  @@index([userId, userReview])
}


// JOB-87 application readiness score
model ApplicationReadinessScore {
  id                 String   @id @default(cuid())
  userId             String   @db.Uuid
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobDescriptionId   String?
  // optional application id when tracker exists
  jobApplicationId   String?
  // ready | partial | sparse
  confidenceBand     String
  // dimension scores JSON validated by readinessDimensionsSchema
  dimensions         Json
  overallScore       Int?
  explanations       Json?
  sourceTimestamps   Json?
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([userId, jobDescriptionId])
}

// JOB-89 application outcomes
model ApplicationOutcome {
  id                 String    @id @default(cuid())
  userId             String    @db.Uuid
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobDescriptionId   String?
  jobApplicationId   String?
  // screening | interview | final | offer | rejected | withdrawn | no_response | applied
  stage              String
  outcome            String?
  stageDate          DateTime?
  employerFeedback   String?   @db.Text
  userInterpretation String?   @db.Text
  perceivedBlockers  String?   @db.Text
  // factual | interpretation | ai_inference labels in meta
  meta               Json?
  isSensitive        Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([userId, stage])
}

// JOB-90 AI usage / cost telemetry
model AiUsageEvent {
  id            String   @id @default(cuid())
  userId        String?  @db.Uuid
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  workflow      String
  taskClass     String
  model         String
  promptVersion String?
  inputTokens   Int?
  outputTokens  Int?
  estimatedCost Float?
  latencyMs     Int?
  retries       Int      @default(0)
  success       Boolean  @default(true)
  validationOk  Boolean?
  // never store raw CV/JD content
  meta          Json?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([workflow])
  @@index([model])
  @@index([createdAt])
  @@index([userId, workflow])
}

// JOB-91 subscription entitlements
model ProductPlan {
  id           String         @id @default(cuid())
  // free | sprint_pass | pro | org
  code         String         @unique
  name         String
  // configuration JSON: entitlements, durationDays, priceCents
  config       Json
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id                 String    @id @default(cuid())
  userId             String    @db.Uuid
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String
  plan               ProductPlan @relation(fields: [planId], references: [id])
  // active | past_due | canceled | expired
  status             String
  provider           String    @default("stub")
  providerCustomerId String?
  providerSubId      String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  billingEvents      BillingEvent[]

  @@index([userId])
  @@index([userId, status])
  @@index([providerSubId])
}

model EntitlementGrant {
  id        String    @id @default(cuid())
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // feature key e.g. mock_interview | cv_rewrite | unlimited_match
  feature   String
  source    String
  // active | expired | revoked
  status    String    @default("active")
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  meta      Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([userId, feature, status])
}

model BillingEvent {
  id             String        @id @default(cuid())
  userId         String?       @db.Uuid
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  // checkout | invoice_paid | invoice_failed | canceled | renewed | webhook_duplicate
  type           String
  providerEventId String?
  payload        Json?
  createdAt      DateTime      @default(now())

  @@unique([providerEventId])
  @@index([userId])
  @@index([subscriptionId])
}
