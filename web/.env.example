DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BLOB_READ_WRITE_TOKEN=
AI_GATEWAY_API_KEY=

# Optional TypeSafe (Jev) rubric scoring. Server-only; required by
# `npm run eval:jev-rubric` and by lib/ai/resume-rubric.ts.
# TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1

# Optional resume structure parser (default: heuristic)
# RESUME_STRUCTURE_PARSER=heuristic
# RESUME_STRUCTURE_PARSER=gliner
# Defaults to <repo>/.venv-gliner/bin/python, or Scripts/python.exe on Windows.
# If the interpreter is missing the server logs a warning once and uses the
# heuristic parser; the review page tells the user autofill was limited.
# GLINER_PYTHON=/absolute/path/to/.venv-gliner/bin/python
# GLINER_MODEL=fastino/gliner2-base-v1
# GLINER_MODE=json
